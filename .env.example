# ===== Atlas - variáveis de ambiente =====
# Copie este arquivo para `.env` e preencha os valores reais.
# NUNCA versionar o arquivo `.env` real (contém chaves/secrets).

# --- Modo de execução ---
# DJANGO_ENV=development | production (seletor de settings)
DJANGO_ENV=development

# --- Segurança ---
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
# Frontend é servido pelo próprio Django na mesma origem (CORS dispensável).
# Preencha apenas se consumir a API de outro domínio (ex.: cliente externo).
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8000
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000

# --- Banco de dados ---
# local:    DB_ENGINE=sqlite  (padrão, funciona sem servidor Postgres)
# producao: DB_ENGINE=postgres (+ pgvector). Exigido para busca semântica.
DB_ENGINE=sqlite
# DATABASE_URL=postgresql://atlas:atlas@localhost:5432/atlas
DB_NAME=atlas
DB_USER=atlas
DB_PASSWORD=atlas
DB_HOST=127.0.0.1
DB_PORT=5432

# --- Gemini (IA) ---
# A chave fica EXCLUSIVAMENTE no backend. Nunca expor no frontend.
# Sem estes valores, o Assistant roda sem LLM (modo determinístico).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# Modelo de embeddings (dimensão 768 para text-embedding-004).
EMBEDDING_MODEL=text-embedding-004
